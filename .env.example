# Copy to .env at the repo root (gitignored); never commit .env. Shell scripts load it with
# `set -a; . ./.env`, Python graders through steering_reasoning.judge.load_env().

# ---- Compute provider -------------------------------------------------------------------
# The repo ships the authors' RunPod tooling (tools/runpod/rp) as a worked example; it reads
# this key. Add tooling for your own provider where the scripts say
# "ADD COMPUTE TOOLING FOR YOUR PROVIDER" and read whatever credential it needs from here.
COMPUTE_API_KEY=

# Hugging Face token, for the model download on the serving box.
HF_TOKEN=

# ---- Judge model ------------------------------------------------------------------------
# Every grader (School of Reward Hacks, stories, decline segments, hack edits, spec citations,
# honest submissions) calls steering_reasoning.judge.complete(), which reads these. Any
# OpenAI-compatible chat-completions service works out of the box (JUDGE_PROVIDER=openai):
# OpenAI, OpenRouter, Together, Fireworks, a local vLLM server, ... Set JUDGE_BASE_URL to its
# endpoint and JUDGE_MODEL to the model id. JUDGE_PROVIDER=bedrock is Amazon Bedrock's
# Converse API, the service the paper's grades came from (GLM-5 as zai.glm-5, us-east-1);
# there JUDGE_API_KEY is a Bedrock API key (or leave it empty to sign with AWS credentials,
# which needs boto3). For anything else, see "ADD JUDGE TOOLING FOR YOUR PROVIDER" in
# src/steering_reasoning/judge.py. A self-hosted endpoint without auth: set JUDGE_BASE_URL and
# leave JUDGE_API_KEY empty.
JUDGE_API_KEY=
JUDGE_PROVIDER=openai
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=
# JUDGE_REGION=us-east-1        # bedrock only
