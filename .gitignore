# Overleaf project (separate git repo, cloned into paper/)
paper/

# SAE checkpoints (Qwen-Scope), pulled by hand; ~3.3 GB per layer
data/saes/

# bf16 activation dumps pulled from S3 (see canonical/INDEX.md)
data/captures/

# local caches of pulled S3 data (data/cache/<set>/) and scratch outputs of live monitors,
# provisioning stages and smoke tests (data/scratch/); formerly under .agent-sandbox/
data/cache/
data/scratch/

# intervention-magnitude: streamed covariance/whitening intermediates (225 MB + 1.9 GB);
# regenerate with its scripts/capture_stats.py, whiten_pass.py (~7 min, CPU)
experiments/intervention-magnitude/artifacts/*.npz

# edit-judge labels (hack-action-anchor): 88 KB result of record that the approach-axis and pre-hack figures read
!experiments/hack-action-anchor/data/
experiments/hack-action-anchor/data/*
!experiments/hack-action-anchor/data/edit_judgments.json

# paper-artifacts driver output (make_paper_artifacts.py)
paper-artifacts/out/

# honest-submission judge labels: the results of record the honest-submit figures and tables read
!experiments/honest-submission-judge/data/
experiments/honest-submission-judge/data/*
!experiments/honest-submission-judge/data/labels.jsonl
!experiments/honest-submission-judge/data/labels_spec.jsonl

# tracked inputs of record that the rules above would otherwise ignore
!experiments/opt-vector/data/
experiments/opt-vector/data/*
!experiments/opt-vector/data/rh_src_train_1k_v3b.jsonl
!experiments/opt-vector/data/rh_src_train_1k_v3c.jsonl
!experiments/intervention-magnitude/artifacts/kappa_opt_L35.npz
# data/: only this README ships
data/*
!data/README.md
